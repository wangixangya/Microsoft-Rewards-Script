# 账号与环境变量模板 —— 复制为 env.list（docker run --env-file 用），不要把真实密码提交
# 账号按序号排列，脚本会自动扫描 ACCOUNT_N_EMAIL
ACCOUNT_1_EMAIL=you@example.com
ACCOUNT_1_PASSWORD=your-password
ACCOUNT_1_GEO_LOCALE=cn

ACCOUNT_2_EMAIL=second@example.com
ACCOUNT_2_PASSWORD=your-password
ACCOUNT_2_GEO_LOCALE=cn

# 可选：二步验证密钥 / 恢复邮箱 / 代理
# ACCOUNT_1_TOTP_SECRET=
# ACCOUNT_1_RECOVERY_EMAIL=
# ACCOUNT_1_PROXY_URL=

# 运行环境
TZ=Asia/Shanghai
NODE_ENV=production
CONFIG_AUTO_SYNC=true
RUN_ON_START=false
SKIP_RANDOM_SLEEP=false
PLAYWRIGHT_BROWSERS_PATH=0
FORCE_HEADLESS=1
NODE_OPTIONS=--disable-warning=ExperimentalWarning
